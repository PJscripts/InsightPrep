APP_NAME=AI Interview Assessment System
APP_VERSION=0.1.0
ENVIRONMENT=development

BACKEND_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgresql+psycopg://interview_user:interview_password@localhost:5432/interview_db
JWT_SECRET=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

RESUME_PRIMARY_LLM=gemini
RESUME_FALLBACK_LLM=groq

QUESTION_PRIMARY_LLM=groq
QUESTION_FALLBACK_LLM=gemini

EVALUATION_PRIMARY_LLM=groq
EVALUATION_FALLBACK_LLM=gemini

LLM_FINAL_FALLBACK=mock

LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_TIMEOUT_SECONDS=30
