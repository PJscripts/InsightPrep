# Application Configuration
APP_NAME=AI Interview Assessment System
APP_VERSION=0.1.0
ENVIRONMENT=development

# Service URLs & CORS
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Database Connection (PostgreSQL with pgvector)
# Note: For default Docker Compose configuration on port 5433, use localhost:5433.
# IMPORTANT: In PowerShell, avoid setting $env:DATABASE_URL="sqlite:///:memory:" in your interactive shell,
# as environment variables take precedence over this .env file and cause database tables to be missing.
DATABASE_URL=postgresql+psycopg://interview_user:interview_password@localhost:5433/interview_db

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_minimum_32_characters
JWT_EXPIRATION_MINUTES=60

# LLM Providers & Resiliency
OPENAI_API_KEY=

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Groq API
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Multi-Provider Routing & Fallbacks (gemini, groq, mock)
RESUME_PRIMARY_LLM=gemini
RESUME_FALLBACK_LLM=groq

QUESTION_PRIMARY_LLM=groq
QUESTION_FALLBACK_LLM=gemini

EVALUATION_PRIMARY_LLM=groq
EVALUATION_FALLBACK_LLM=gemini

LLM_FINAL_FALLBACK=mock
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# ElevenLabs Speech Synthesis (Text-to-Speech)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_TIMEOUT_SECONDS=30
